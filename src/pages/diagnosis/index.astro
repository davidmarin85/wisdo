---
// /diagnosis/ — entrada del diagnóstico: URL de la web + UNA pregunta.
// Al enviar, llama a /api/analyze y va pintando en directo lo que descubre
// (stream NDJSON): web leída, herramientas, modelo de negocio, servicios,
// nicho, cliente y stack. Al terminar NO enseña el stack: pide el email
// (/api/capture guarda el email, genera el "por qué" y envía el informe) y
// solo entonces redirige a /diagnosis/{id}/, que ya sale desbloqueada.
//
// El escáner está en components/diagnosis/DiagnosisScanner.astro, que
// comparte con el dashboard (/dashboard/analyze/).
import SiteLayout from '@layouts/SiteLayout.astro';
import DiagnosisScanner from '@components/diagnosis/DiagnosisScanner.astro';

// Viene del formulario del hero de la home (/diagnosis/?url=…).
const prefillUrl = (Astro.url.searchParams.get('url') ?? '').slice(0, 300);
---

<SiteLayout
  title="Sales stack diagnosis — wisdo"
  description="We analyze your website and tell you which tools you need to find and close more clients."
>
  <div class="dg">
    <section class="dg-hero">
      <div class="dg-eyebrow">Free diagnosis</div>
      <h1 class="dg-h1">Which sales stack does your business need?</h1>
      <p class="dg-lead">We analyze your website and recommend the tools to find and close more clients. It takes a few seconds.</p>
    </section>

    <DiagnosisScanner prefillUrl={prefillUrl} />
  </div>
</SiteLayout>

<style>
  .dg {
    max-width: 760px;
    margin: 0 auto;
    padding: 72px 24px 96px;
  }
  .dg-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.85px;
    text-transform: uppercase;
    color: #a7a7a7;
  }
  .dg-h1 {
    margin: 20px 0 0;
    font-size: clamp(32px, 5vw, 52px);
    line-height: 1.1;
    letter-spacing: -1.8px;
    font-weight: 500;
    text-wrap: balance;
  }
  .dg-lead {
    margin: 16px 0 0;
    font-size: 17px;
    line-height: 1.55;
    color: #a7a7a7;
  }
  @media (max-width: 600px) {
    .dg { padding: 48px 16px 72px; }
  }
</style>
