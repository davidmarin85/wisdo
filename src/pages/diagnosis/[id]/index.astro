---
// /diagnosis/{id}/ — el informe del diagnóstico.
// El uuid es la única llave (no hay login), así que la página es noindex y
// no se cachea. Se lee con service_role y solo se piden las columnas que se
// pintan: el email del lead nunca sale al HTML.
//
// El resultado entero está bloqueado hasta que el usuario deja su email.
// Normalmente llega ya desbloqueado (la puerta de email vive en /diagnosis/,
// al acabar el análisis); si entra sin email (reload, enlace copiado), la
// página solo pinta la puerta: el formulario llama a /api/capture, que genera
// el "por qué" con Claude y envía el email, y al volver recargamos.
//
// El informe en sí está en components/diagnosis/DiagnosisReport.astro, que
// comparte con el dashboard (/dashboard/report/).
import SiteLayout from '@layouts/SiteLayout.astro';
import DiagnosisReport from '@components/diagnosis/DiagnosisReport.astro';
import { createSupabaseAdminClient } from '@lib/supabase-admin';
import { REPORT_COLUMNS, type ReportLead } from '@lib/report-lead';
import { STACKS, resolveDiagnosis } from '@lib/wisdo-engine';

const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

type ResultLead = ReportLead & { email_captured_at: string | null };

Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

const id = Astro.params.id ?? '';
if (!UUID_RE.test(id)) {
  return new Response(null, { status: 404 });
}

const supabase = createSupabaseAdminClient();
const { data: lead } = await supabase
  .from('leads')
  .select(`${REPORT_COLUMNS}, email_captured_at`)
  .eq('id', id)
  .maybeSingle<ResultLead>();

if (!lead) {
  return new Response(null, { status: 404 });
}

const stack = (lead.stack_key && STACKS[lead.stack_key]) || resolveDiagnosis(lead.answers_raw ?? {}).stack;
const siteHost = lead.website_url ? new URL(lead.website_url).hostname.replace(/^www\./, '') : null;
const unlocked = Boolean(lead.email_captured_at);
---

<SiteLayout
  title={unlocked ? `Your stack: ${stack.name} — wisdo` : 'Your diagnosis is ready — wisdo'}
  description="Your personalized sales stack diagnosis."
  noindex
>
  {unlocked ? (
    <DiagnosisReport lead={lead} from="resultado" showDashboardLink />
  ) : (
    <div class="lockd">
      <div class="lockd-eyebrow">wisdo diagnosis{siteHost && <> · {siteHost}</>}</div>
      <h1 class="lockd-h1">Your diagnosis is ready.</h1>
      <p class="lockd-lead">Leave your email to see the sales stack we recommend{siteHost ? ` for ${siteHost}` : ''} and why it fits your business. We also send you the full report.</p>
      <form class="gate" data-capture-form novalidate>
        <input type="hidden" name="id" value={lead.id} />
        <div class="gate-row">
          <input class="gate-input" name="email" type="email" required autocomplete="email" placeholder="you@company.com" maxlength="254" aria-label="Email" />
          <button class="gate-btn" type="submit">See my stack</button>
        </div>
        <p class="gate-error" role="alert" hidden></p>
        <p class="gate-legal">We only use your email to send you the diagnosis and, now and then, ideas to sell more. You can unsubscribe at any time.</p>
      </form>
    </div>
  )}
</SiteLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-capture-form]');
  if (form) {
    const btn = form.querySelector<HTMLButtonElement>('.gate-btn')!;
    const input = form.querySelector<HTMLInputElement>('input[name="email"]')!;
    const errorEl = form.querySelector<HTMLParagraphElement>('.gate-error')!;
    const btnLabel = btn.textContent;
    const id = form.querySelector<HTMLInputElement>('input[name="id"]')!.value;

    const showError = (msg: string) => {
      errorEl.textContent = msg;
      errorEl.hidden = false;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.hidden = true;
      const email = input.value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showError('Enter a valid email.');
        input.focus();
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Preparing your diagnosis…';
      try {
        const res = await fetch('/api/capture/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id, email }),
        });
        if (!res.ok) throw new Error(String(res.status));
        window.location.reload();
      } catch {
        btn.disabled = false;
        btn.textContent = btnLabel;
        showError('We couldn’t save your email. Please try again.');
      }
    });
  }
</script>

<style>
  .lockd {
    max-width: 960px;
    margin: 0 auto;
    padding: 72px 24px 96px;
  }
  .lockd-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.85px;
    text-transform: uppercase;
    color: #a7a7a7;
  }
  .lockd-h1 {
    margin: 20px 0 0;
    font-size: clamp(34px, 5vw, 56px);
    line-height: 1.1;
    letter-spacing: -2px;
    font-weight: 500;
    text-wrap: balance;
  }
  .lockd-lead {
    margin: 20px 0 0;
    font-size: 20px;
    line-height: 1.5;
    letter-spacing: -0.3px;
    color: #e6e6e6;
    max-width: 720px;
  }

  /* Puerta de email */
  .gate {
    margin-top: 40px;
    padding: 24px;
    background: #141414;
    border: 1px solid #1e1e1e;
    border-radius: 8px;
    max-width: 640px;
  }
  .gate-row { display: flex; gap: 8px; }
  .gate-input {
    flex: 1;
    min-width: 0;
    background: #0a0a0a;
    border: 1px solid #313131;
    border-radius: 8px;
    padding: 12px 14px;
    color: #ffffff;
    font: inherit;
    font-size: 15px;
  }
  .gate-input:focus { outline: none; border-color: #6798ff; }
  .gate-btn {
    background: #ffffff;
    color: #0a0a0a;
    border: 0;
    border-radius: 8px;
    padding: 12px 18px;
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
  }
  .gate-btn:disabled { opacity: 0.7; cursor: progress; }
  .gate-error { margin: 10px 0 0; font-size: 13px; color: #ff7a7a; }
  .gate-legal { margin: 12px 0 0; font-size: 12px; line-height: 1.5; color: #7c7c7c; }

  @media (max-width: 720px) {
    .lockd { padding: 48px 16px 72px; }
    .lockd-lead { font-size: 18px; }
  }
  @media (max-width: 480px) {
    .gate-row { flex-direction: column; }
  }
</style>
