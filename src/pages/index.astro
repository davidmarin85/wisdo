---
import SiteLayout from '@layouts/SiteLayout.astro';
import { BOOK_A_CALL_URL } from '@data/site';
---

<SiteLayout
  title="wisdo — AI-powered growth consultancy"
  description="We connect your ads, CRM and content into one automated system. Certified HubSpot, Google and Meta partners."
  active="solutions"
>

<section id="top" style="background-color:#0a0a0a; background-image:linear-gradient(#1e1e1e 1px, transparent 1px), linear-gradient(90deg, #1e1e1e 1px, transparent 1px); background-size:48px 48px; border-bottom:1px solid #1e1e1e;">
    <div style="max-width:1200px; margin:0 auto; padding:96px 24px; display:grid; grid-template-columns:repeat(auto-fit,minmax(380px,1fr)); gap:64px; align-items:center;">
      <div>
        <div style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.85px; text-transform:uppercase; color:#a7a7a7; margin-bottom:24px;">AI-powered growth consultancy</div>
        <h1 style="margin:0; font-size:clamp(38px,5.2vw,64px); line-height:1.13; letter-spacing:-2.3px; font-weight:500; text-wrap:balance;">Marketing that runs itself. Measured end to end.</h1>
        <p style="margin:24px 0 0; font-size:16px; line-height:1.5; letter-spacing:-0.25px; color:#a7a7a7; max-width:480px;">We connect your ads, CRM and content into one automated system, then let AI handle the optimization you don't have time for. We're certified HubSpot partners working with growth teams across Spain and Latin America.</p>
        <div style="display:flex; gap:8px; margin-top:32px; flex-wrap:wrap;">
          <a href={BOOK_A_CALL_URL} style="background:#ffffff; color:#0a0a0a; padding:12px 20px; border-radius:8px; font-size:14px; font-weight:500;" class="h6">Book a call</a>
          <a href={BOOK_A_CALL_URL} style="border:1px solid #454545; padding:12px 20px; border-radius:8px; font-size:14px; font-weight:500;" class="h7">Get a free strategy session</a>
        </div>
        <div style="margin-top:32px; font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.85px; color:#7c7c7c; text-transform:uppercase;">Certified partner: HubSpot · Google Ads · Meta</div>
      </div>

      <div style="background:#141414; border:1px solid #1e1e1e; border-radius:8px; padding:24px;">
        <div style="display:flex; align-items:center; gap:8px; padding-bottom:16px; border-bottom:1px solid #1e1e1e;">
          <span style="width:8px; height:8px; border-radius:2px; background:#6798ff;"></span>
          <span style="font-size:14px; font-weight:500; letter-spacing:-0.25px;">Pipeline performance</span>
          <span style="flex:1;"></span>
          <span style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#a7a7a7; border:1px solid #313131; border-radius:4px; padding:3px 8px;">LAST 30 DAYS</span>
        </div>

        <div style="display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; padding:16px 0; border-bottom:1px solid #1e1e1e;">
          <div>
            <div style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.85px; color:#a7a7a7;">CPL</div>
            <div style="font-size:24px; font-weight:500; letter-spacing:-0.6px; margin-top:4px;">€18.40</div>
          </div>
          <div>
            <div style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.85px; color:#a7a7a7;">MQL</div>
            <div style="font-size:24px; font-weight:500; letter-spacing:-0.6px; margin-top:4px;">412</div>
          </div>
          <div>
            <div style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.85px; color:#a7a7a7;">WIN RATE</div>
            <div style="font-size:24px; font-weight:500; letter-spacing:-0.6px; margin-top:4px; color:#6798ff;">24%</div>
          </div>
        </div>

        <div style="display:flex; align-items:flex-end; gap:6px; height:132px; padding:24px 0 16px;">
          <div style="flex:1; height:38%; background:#313131; border-radius:3px 3px 0 0;"></div>
          <div style="flex:1; height:52%; background:#313131; border-radius:3px 3px 0 0;"></div>
          <div style="flex:1; height:44%; background:#313131; border-radius:3px 3px 0 0;"></div>
          <div style="flex:1; height:66%; background:#6798ff; border-radius:3px 3px 0 0;"></div>
          <div style="flex:1; height:58%; background:#313131; border-radius:3px 3px 0 0;"></div>
          <div style="flex:1; height:79%; background:#6798ff; border-radius:3px 3px 0 0;"></div>
          <div style="flex:1; height:71%; background:#313131; border-radius:3px 3px 0 0;"></div>
          <div style="flex:1; height:94%; background:#6798ff; border-radius:3px 3px 0 0;"></div>
        </div>

        <div style="border-top:1px solid #1e1e1e; display:grid; grid-template-columns:1.4fr 1fr 0.8fr; gap:8px; padding:12px 0; font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.85px; color:#a7a7a7;">
          <span>CHANNEL</span><span>SPEND</span><span>ROAS</span>
        </div>
        <div style="display:grid; grid-template-columns:1.4fr 1fr 0.8fr; gap:8px; padding:10px 0; border-top:1px solid #1e1e1e; font-size:14px; letter-spacing:-0.25px;">
          <span>Google Ads</span><span style="color:#a7a7a7;">€12,400</span><span>4.1×</span>
        </div>
        <div style="display:grid; grid-template-columns:1.4fr 1fr 0.8fr; gap:8px; padding:10px 0; border-top:1px solid #1e1e1e; font-size:14px; letter-spacing:-0.25px;">
          <span>Meta Ads</span><span style="color:#a7a7a7;">€8,900</span><span>3.3×</span>
        </div>
        <div style="display:grid; grid-template-columns:1.4fr 1fr 0.8fr; gap:8px; padding:10px 0; border-top:1px solid #1e1e1e; font-size:14px; letter-spacing:-0.25px;">
          <span>Inbound (HubSpot)</span><span style="color:#a7a7a7;">€3,100</span><span>6.8×</span>
        </div>
      </div>
    </div>
  </section>

  <section style="border-bottom:1px solid #1e1e1e;">
    <div class="logo-strip" style="max-width:1200px; margin:0 auto; padding:40px 24px; display:flex; align-items:center; gap:40px; flex-wrap:wrap;">
      <div class="logo-strip__label" style="font-size:14px; font-weight:500; letter-spacing:-0.25px; max-width:260px;">Trusted by growing companies</div>
      <div class="logo-strip__items" style="flex:1; display:flex; align-items:center; gap:40px; flex-wrap:wrap; font-family:'JetBrains Mono',monospace; font-size:14px; letter-spacing:1.16px; color:#a7a7a7;">
        <span>NORTHBEAM</span><span>ALDARA</span><span>VELTRIX</span><span>CASA&nbsp;MAR</span><span>OPENLOOP</span><span>TERRANOVA</span>
      </div>
    </div>
  </section>

  <section id="results" style="border-bottom:1px solid #1e1e1e;">
    <div style="max-width:1200px; margin:0 auto; padding:80px 24px;">
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:32px; text-align:center;">
        <div>
          <div style="color:#6798ff; font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.85px;">↑ CONVERSION</div>
          <div style="font-size:40px; font-weight:500; letter-spacing:-0.84px; margin-top:16px;">+38%</div>
          <div style="font-size:16px; font-weight:500; letter-spacing:-0.25px; margin-top:8px;">Average lift in qualified leads</div>
          <div style="font-size:14px; line-height:1.57; letter-spacing:-0.25px; color:#a7a7a7; margin-top:8px;">Measured across client accounts in the first two quarters after onboarding.</div>
        </div>
        <div>
          <div style="color:#6798ff; font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.85px;">◷ TIME SAVED</div>
          <div style="font-size:40px; font-weight:500; letter-spacing:-0.84px; margin-top:16px;">20h</div>
          <div style="font-size:16px; font-weight:500; letter-spacing:-0.25px; margin-top:8px;">Returned to the team each month</div>
          <div style="font-size:14px; line-height:1.57; letter-spacing:-0.25px; color:#a7a7a7; margin-top:8px;">Reporting, lead routing and follow-up handled by workflows instead of people.</div>
        </div>
        <div>
          <div style="color:#6798ff; font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.85px;">⌾ EFFICIENCY</div>
          <div style="font-size:40px; font-weight:500; letter-spacing:-0.84px; margin-top:16px;">−27%</div>
          <div style="font-size:16px; font-weight:500; letter-spacing:-0.25px; margin-top:8px;">Lower cost per acquisition</div>
          <div style="font-size:14px; line-height:1.57; letter-spacing:-0.25px; color:#a7a7a7; margin-top:8px;">Budget reallocated continuously by models rather than monthly by hand.</div>
        </div>
      </div>
      <div style="text-align:center; font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.85px; color:#7c7c7c; margin-top:40px;">PLACEHOLDER FIGURES — REPLACE WITH YOUR REAL NUMBERS</div>
    </div>
  </section>

  <section id="services" style="border-bottom:1px solid #1e1e1e;">
    <div style="max-width:1200px; margin:0 auto; padding:80px 24px;">
      <div style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.85px; text-transform:uppercase; color:#a7a7a7;">What we do</div>
      <h2 style="margin:32px 0 0; font-size:clamp(28px,3.6vw,40px); line-height:1.2; letter-spacing:-0.84px; font-weight:500; max-width:640px;">A strategic partner for the parts of growth that stall.</h2>
      <p style="margin:16px 0 0; font-size:16px; line-height:1.5; letter-spacing:-0.25px; color:#a7a7a7; max-width:640px;">We work alongside your team rather than around it — diagnosing where the funnel loses momentum, then building the campaigns, processes and automations that fix it.</p>

      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:16px; margin-top:40px;">
        <a href="/ai-automation/" style="display:block; background:#141414; border:1px solid #1e1e1e; border-radius:8px; padding:24px;" class="h8">
          <div style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.85px; color:#6798ff;">01 — AI &amp; AUTOMATION</div>
          <div style="font-size:20px; font-weight:500; letter-spacing:-0.42px; margin-top:16px;">AI &amp; marketing automation</div>
          <div style="font-size:14px; line-height:1.57; letter-spacing:-0.25px; color:#a7a7a7; margin-top:8px;">Workflows, lead scoring and predictive budget allocation wired into the tools you already pay for.</div>
          <div style="font-size:14px; font-weight:500; color:#6798ff; margin-top:16px;">Explore the practice →</div>
        </a>
        <div style="background:#141414; border:1px solid #1e1e1e; border-radius:8px; padding:24px;">
          <div style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.85px; color:#a7a7a7;">02 — PAID MEDIA</div>
          <div style="font-size:20px; font-weight:500; letter-spacing:-0.42px; margin-top:16px;">Campaign launch &amp; optimization</div>
          <div style="font-size:14px; line-height:1.57; letter-spacing:-0.25px; color:#a7a7a7; margin-top:8px;">Google and Meta campaigns built around your unit economics, tuned weekly against pipeline rather than clicks.</div>
        </div>
        <div style="background:#141414; border:1px solid #1e1e1e; border-radius:8px; padding:24px;">
          <div style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.85px; color:#a7a7a7;">03 — REVENUE OPS</div>
          <div style="font-size:20px; font-weight:500; letter-spacing:-0.42px; margin-top:16px;">Sales consulting on HubSpot</div>
          <div style="font-size:14px; line-height:1.57; letter-spacing:-0.25px; color:#a7a7a7; margin-top:8px;">CRM implementation, pipeline design and sales process work so marketing effort converts into closed deals.</div>
        </div>
        <div style="background:#141414; border:1px solid #1e1e1e; border-radius:8px; padding:24px;">
          <div style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.85px; color:#a7a7a7;">04 — ANALYTICS</div>
          <div style="font-size:20px; font-weight:500; letter-spacing:-0.42px; margin-top:16px;">Tracking &amp; attribution</div>
          <div style="font-size:14px; line-height:1.57; letter-spacing:-0.25px; color:#a7a7a7; margin-top:8px;">UTM discipline, server-side conversions and dashboards that agree with each other, so decisions rest on one number.</div>
        </div>
      </div>
    </div>
  </section>

  <section id="method" style="background-color:#0a0a0a; background-image:linear-gradient(#1e1e1e 1px, transparent 1px), linear-gradient(90deg, #1e1e1e 1px, transparent 1px); background-size:48px 48px; border-bottom:1px solid #1e1e1e;">
    <div style="max-width:1200px; margin:0 auto; padding:80px 24px;">
      <div style="text-align:center;">
        <div style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.85px; text-transform:uppercase; color:#a7a7a7;">How it works</div>
        <h2 style="margin:32px auto 0; font-size:clamp(28px,3.6vw,40px); line-height:1.2; letter-spacing:-0.84px; font-weight:500; max-width:720px;">Build, measure, learn — on a two-week cycle.</h2>
      </div>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:16px; margin-top:40px;">
        <div style="background:#141414; border:1px solid #1e1e1e; border-radius:8px; padding:24px;">
          <div style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.85px; color:#6798ff;">STEP 01</div>
          <div style="font-size:20px; font-weight:500; letter-spacing:-0.42px; margin-top:16px;">Diagnose</div>
          <p style="margin:8px 0 0; font-size:14px; line-height:1.57; letter-spacing:-0.25px; color:#a7a7a7;">We audit your channels, CRM and competitive position, and agree on the one metric the quarter is judged by.</p>
        </div>
        <div style="background:#141414; border:1px solid #1e1e1e; border-radius:8px; padding:24px;">
          <div style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.85px; color:#6798ff;">STEP 02</div>
          <div style="font-size:20px; font-weight:500; letter-spacing:-0.42px; margin-top:16px;">Instrument</div>
          <p style="margin:8px 0 0; font-size:14px; line-height:1.57; letter-spacing:-0.25px; color:#a7a7a7;">Tracking, attribution and reporting go in first. Nothing is optimized before it can be measured honestly.</p>
        </div>
        <div style="background:#141414; border:1px solid #1e1e1e; border-radius:8px; padding:24px;">
          <div style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.85px; color:#6798ff;">STEP 03</div>
          <div style="font-size:20px; font-weight:500; letter-spacing:-0.42px; margin-top:16px;">Automate</div>
          <p style="margin:8px 0 0; font-size:14px; line-height:1.57; letter-spacing:-0.25px; color:#a7a7a7;">Repetitive work moves into workflows and models — routing, nurturing, bidding, reporting — and stays there.</p>
        </div>
        <div style="background:#141414; border:1px solid #1e1e1e; border-radius:8px; padding:24px;">
          <div style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.85px; color:#6798ff;">STEP 04</div>
          <div style="font-size:20px; font-weight:500; letter-spacing:-0.42px; margin-top:16px;">Iterate</div>
          <p style="margin:8px 0 0; font-size:14px; line-height:1.57; letter-spacing:-0.25px; color:#a7a7a7;">Every sprint closes with a review: what moved, what didn't, and what the next two weeks test.</p>
        </div>
      </div>
    </div>
  </section>

  <section style="border-bottom:1px solid #1e1e1e;">
    <div style="max-width:1200px; margin:0 auto; padding:80px 24px; display:grid; grid-template-columns:repeat(auto-fit,minmax(380px,1fr)); gap:64px; align-items:center;">
      <div>
        <div style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.85px; text-transform:uppercase; color:#a7a7a7;">Certified partners</div>
        <h2 style="margin:32px 0 0; font-size:clamp(28px,3.6vw,40px); line-height:1.2; letter-spacing:-0.84px; font-weight:500;">HubSpot, run properly.</h2>
        <p style="margin:16px 0 0; font-size:16px; line-height:1.5; letter-spacing:-0.25px; color:#a7a7a7;">Most teams buy the platform and use a tenth of it. As certified partners we implement the CRM, migrate your data, design the pipeline and connect it to the rest of your stack — then train the people who live in it every day.</p>
        <div style="display:flex; gap:8px; margin-top:32px; flex-wrap:wrap;">
          <a href={BOOK_A_CALL_URL} style="background:#ffffff; color:#0a0a0a; padding:12px 20px; border-radius:8px; font-size:14px; font-weight:500;" class="h9">Talk to a consultant</a>
          <a href="/ai-automation/" style="border:1px solid #454545; padding:12px 20px; border-radius:8px; font-size:14px; font-weight:500;" class="h10">See the AI practice</a>
        </div>
      </div>
      <div style="display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1px; background:#1e1e1e; border:1px solid #1e1e1e; border-radius:8px; overflow:hidden;">
        <div style="background:#141414; padding:24px;">
          <div style="font-size:24px; font-weight:500; letter-spacing:-0.6px;">CRM</div>
          <div style="font-size:14px; line-height:1.57; color:#a7a7a7; margin-top:8px;">Implementation &amp; migration</div>
        </div>
        <div style="background:#141414; padding:24px;">
          <div style="font-size:24px; font-weight:500; letter-spacing:-0.6px;">Ops</div>
          <div style="font-size:14px; line-height:1.57; color:#a7a7a7; margin-top:8px;">Workflows &amp; lifecycle stages</div>
        </div>
        <div style="background:#141414; padding:24px;">
          <div style="font-size:24px; font-weight:500; letter-spacing:-0.6px;">Data</div>
          <div style="font-size:14px; line-height:1.57; color:#a7a7a7; margin-top:8px;">Reporting &amp; attribution models</div>
        </div>
        <div style="background:#141414; padding:24px;">
          <div style="font-size:24px; font-weight:500; letter-spacing:-0.6px;">Team</div>
          <div style="font-size:14px; line-height:1.57; color:#a7a7a7; margin-top:8px;">Enablement &amp; documentation</div>
        </div>
      </div>
    </div>
  </section>

  <section id="market-teaser" style="border-bottom:1px solid #1e1e1e;">
    <div style="max-width:1200px; margin:0 auto; padding:80px 24px; display:grid; grid-template-columns:repeat(auto-fit,minmax(380px,1fr)); gap:64px; align-items:center;">
      <div>
        <div style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.85px; text-transform:uppercase; color:#a7a7a7;">wisdo Market</div>
        <h2 style="margin:32px 0 0; font-size:clamp(28px,3.6vw,40px); line-height:1.2; letter-spacing:-0.84px; font-weight:500;">The tools we use, vetted and compared.</h2>
        <p style="margin:16px 0 0; font-size:16px; line-height:1.5; letter-spacing:-0.25px; color:#a7a7a7;">Our marketplace is the same shortlist we work from on client projects. Answer four questions and it builds the stack that fits your business — which tools, in what order, and what it costs per month.</p>
        <a href="/market/" style="display:inline-block; margin-top:32px; border:1px solid #454545; padding:12px 20px; border-radius:8px; font-size:14px; font-weight:500;" class="h11">Open the marketplace →</a>
      </div>
      <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:1px; background:#1e1e1e; border:1px solid #1e1e1e; border-radius:8px; overflow:hidden;">
        <div style="background:#141414; padding:24px;">
          <div style="font-size:24px; font-weight:500; letter-spacing:-0.6px;">6</div>
          <div style="font-size:14px; color:#a7a7a7; margin-top:8px;">Tools vetted</div>
        </div>
        <div style="background:#141414; padding:24px;">
          <div style="font-size:24px; font-weight:500; letter-spacing:-0.6px;">5</div>
          <div style="font-size:14px; color:#a7a7a7; margin-top:8px;">Categories</div>
        </div>
        <div style="background:#141414; padding:24px;">
          <div style="font-size:24px; font-weight:500; letter-spacing:-0.6px; color:#6798ff;">100%</div>
          <div style="font-size:14px; color:#a7a7a7; margin-top:8px;">Hand-picked</div>
        </div>
        <div style="background:#141414; padding:24px;">
          <div style="font-size:24px; font-weight:500; letter-spacing:-0.6px;">0</div>
          <div style="font-size:14px; color:#a7a7a7; margin-top:8px;">Paid rankings</div>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" style="background-color:#0a0a0a; background-image:linear-gradient(#1e1e1e 1px, transparent 1px), linear-gradient(90deg, #1e1e1e 1px, transparent 1px); background-size:48px 48px; border-bottom:1px solid #1e1e1e;">
    <div style="max-width:1200px; margin:0 auto; padding:96px 24px; text-align:center;">
      <div style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.85px; text-transform:uppercase; color:#a7a7a7;">Next step</div>
      <h2 style="margin:32px auto 0; font-size:clamp(32px,4.4vw,56px); line-height:1.14; letter-spacing:-1.74px; font-weight:500; max-width:800px;">Tell us what's not growing.</h2>
      <p style="margin:16px auto 0; font-size:16px; line-height:1.5; letter-spacing:-0.25px; color:#a7a7a7; max-width:520px;">Thirty minutes, no deck. We'll look at your funnel together and say plainly whether we're the right partner for it.</p>
      <div style="display:flex; gap:8px; margin-top:32px; justify-content:center; flex-wrap:wrap;">
        <a href={BOOK_A_CALL_URL} style="background:#ffffff; color:#0a0a0a; padding:12px 20px; border-radius:8px; font-size:14px; font-weight:500;" class="h12">Book a call</a>
        <a href="mailto:davidmarin@wisdglobal.com" style="border:1px solid #454545; padding:12px 20px; border-radius:8px; font-size:14px; font-weight:500;" class="h13">Email us instead</a>
      </div>
    </div>
  </section>

</SiteLayout>

<style>
  .h6:hover { background:#e6e6e6 !important; color:#0a0a0a !important }
  .h7:hover { border-color:#7c7c7c !important; color:#ffffff !important }
  .h8:hover { border-color:#313131 !important; color:#ffffff !important }
