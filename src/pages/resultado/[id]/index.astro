---
// /resultado/{id}/ — el informe del diagnóstico.
// El uuid es la única llave (no hay login), así que la página es noindex y
// no se cachea. Se lee con service_role y solo se piden las columnas que se
// pintan: el email del lead nunca sale al HTML.
//
// El "por qué este stack" (ai_diagnosis) está bloqueado hasta que el usuario
// deja su email: el formulario llama a /api/capture, que genera el texto con
// Claude y envía el email; al volver recargamos la página ya desbloqueada.
import SiteLayout from '@layouts/SiteLayout.astro';
import { BOOK_A_CALL_URL } from '@data/site';
import { toolUrl } from '@lib/tool-links';
import { createSupabaseAdminClient } from '@lib/supabase-admin';
import { ARCHETYPES, QUESTIONS, STACKS, resolveDiagnosis, type QuizAnswers } from '@lib/wisdo-engine';

const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

interface WebsiteProfile {
  resumen?: string;
  modelo_negocio?: string;
  servicios?: string[];
  nicho?: string;
  cliente_ideal?: string;
  confianza?: string;
  detected_tools?: string[];
}

interface ResultLead {
  id: string;
  problema_raiz: string;
  tipo_negocio: string | null;
  etapa: string | null;
  archetype: string | null;
  stack_key: string | null;
  answers_raw: QuizAnswers | null;
  email_captured_at: string | null;
  ai_diagnosis: string | null;
  website_url: string | null;
  website_profile: WebsiteProfile | null;
}

Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

const id = Astro.params.id ?? '';
if (!UUID_RE.test(id)) {
  return new Response(null, { status: 404 });
}

const supabase = createSupabaseAdminClient();
const { data: lead } = await supabase
  .from('leads')
  .select('id, problema_raiz, tipo_negocio, etapa, archetype, stack_key, answers_raw, email_captured_at, ai_diagnosis, website_url, website_profile')
  .eq('id', id)
  .maybeSingle<ResultLead>();

if (!lead) {
  return new Response(null, { status: 404 });
}

// Si el stack guardado ya no existe (renombrado en el motor), se recalcula.
const fallback = resolveDiagnosis(lead.answers_raw ?? {});
const stack = (lead.stack_key && STACKS[lead.stack_key]) || fallback.stack;
const archetype = Object.values(ARCHETYPES).find((a) => a.name === lead.archetype) ?? fallback.archetype;

function optionLabel(questionId: string, value: string | null): string | null {
  if (!value) return null;
  const q = QUESTIONS.find((x) => x.id === questionId);
  return q?.options.find((o) => o.value === value)?.label ?? null;
}

const problemaLabel = optionLabel('problema_raiz', lead.problema_raiz);
const tipoLabel = optionLabel('tipo_negocio', lead.tipo_negocio) ?? 'Otro';
const etapaLabel = optionLabel('etapa', lead.etapa) ?? '—';

const profile = lead.website_profile;
const detectedTools = profile?.detected_tools ?? [];
// Leads analizados antes de que existieran estos campos no los tienen.
const analysis = [
  { label: 'Modelo de negocio', value: profile?.modelo_negocio },
  { label: 'Nicho', value: profile?.nicho },
  { label: 'Perfil de cliente', value: profile?.cliente_ideal },
].filter((a): a is { label: string; value: string } => Boolean(a.value));
const servicios = profile?.servicios ?? [];
const siteHost = lead.website_url ? new URL(lead.website_url).hostname.replace(/^www\./, '') : null;

const unlocked = Boolean(lead.email_captured_at);
const aiText = lead.ai_diagnosis;
---

<SiteLayout
  title={`Tu stack: ${stack.name} — wisdo`}
  description="Tu diagnóstico de stack de ventas personalizado."
  noindex
  lang="es"
>
  <div class="res">
    <!-- 1. Análisis de la web -->
    <section class="res-hero">
      <div class="res-eyebrow">Diagnóstico wisdo{siteHost && <> · {siteHost}</>}</div>
      {profile?.resumen ? (
        <>
          <h1 class="res-h1">Hemos analizado tu web.</h1>
          <p class="res-lead">{profile.resumen}</p>
          {(analysis.length > 0 || servicios.length > 0) && (
            <div class="analysis">
              {analysis.map((a) => (
                <div class="analysis-item">
                  <div class="tile-label">{a.label}</div>
                  <div class="analysis-value">{a.value}</div>
                </div>
              ))}
              {servicios.length > 0 && (
                <div class="analysis-item analysis-item--wide">
                  <div class="tile-label">Servicios</div>
                  <div class="chips">{servicios.map((sv) => <span class="chip chip--text">{sv}</span>)}</div>
                </div>
              )}
            </div>
          )}
        </>
      ) : (
        <>
          <h1 class="res-h1">Tu diagnóstico está listo.</h1>
          <p class="res-lead">Este es el stack que mejor encaja con lo que nos has contado.</p>
        </>
      )}
    </section>

    <!-- 2. Fichas -->
    <section class="res-tiles" aria-label="Resumen">
      <div class="tile">
        <div class="tile-label">Problema</div>
        <div class="tile-value tile-value--sm">{problemaLabel}</div>
      </div>
      <div class="tile">
        <div class="tile-label">Negocio</div>
        <div class="tile-value">{tipoLabel}</div>
      </div>
      <div class="tile">
        <div class="tile-label">Etapa</div>
        <div class="tile-value">{etapaLabel}</div>
      </div>
      <div class="tile">
        <div class="tile-label">Coste del stack</div>
        <div class="tile-value tile-value--accent">{stack.cost}</div>
      </div>
      {lead.website_url && (
        <div class="tile tile--wide">
          <div class="tile-label">Herramientas detectadas en tu web</div>
          {detectedTools.length > 0 ? (
            <div class="chips">{detectedTools.map((t) => <span class="chip">{t}</span>)}</div>
          ) : (
            <div class="tile-note">No hemos encontrado herramientas de ventas ni de marketing, así que no tendrás nada que migrar.</div>
          )}
        </div>
      )}
    </section>

    <!-- 3. Arquetipo + stack -->
    <section class="res-section">
      <div class="res-eyebrow">Tu perfil</div>
      <div class="archetype">
        <span class="archetype-emoji" aria-hidden="true">{archetype.emoji}</span>
        <div>
          <div class="archetype-name">{archetype.name}</div>
          <div class="archetype-tag">{archetype.tagline}</div>
        </div>
      </div>

      <h2 class="res-h2">{stack.name}</h2>
      <div class="stack">
        {stack.tools.map((t, i) => {
          const url = toolUrl(t.name);
          return (
            <article class="tool">
              <div class="tool-head">
                <span class="res-mono tool-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="tool-name">{t.name}</span>
                {t.free && <span class="tool-badge">Plan gratis</span>}
              </div>
              <p class="tool-role">{t.role}</p>
              {url && (
                <a class="tool-cta" href={url} target="_blank" rel="noopener sponsored">Probar {t.name} →</a>
              )}
            </article>
          );
        })}
      </div>
      {stack.alt && <p class="res-sub"><span class="res-mono">Alternativa</span> {stack.alt}</p>}
    </section>

    <!-- 4. Por qué este stack (bloqueado hasta dejar el email) -->
    <section class="res-section">
      <div class="res-eyebrow">Por qué este stack es para ti</div>
      {unlocked ? (
        <div class="why">
          {aiText ? (
            <p class="why-text">{aiText}</p>
          ) : (
            <p class="why-text">Te hemos enviado el diagnóstico completo por email. Si no lo ves, revisa la carpeta de spam o promociones.</p>
          )}
        </div>
      ) : (
        <div class="lock">
          <div class="lock-preview" aria-hidden="true">
            <p>Este stack ataca el problema que nos has marcado con las herramientas que mejor encajan en la etapa de tu negocio. Te explicamos por qué cada una tiene sentido en tu caso.</p>
            <p>Te llega también por email en cuanto nos dejes tu dirección.</p>
          </div>
          <form class="lock-card" data-capture-form novalidate>
            <div class="lock-title">Desbloquea tu diagnóstico personalizado</div>
            <p class="lock-text">Te explicamos por qué este stack encaja con tu negocio y te enviamos el informe por email.</p>
            <input type="hidden" name="id" value={lead.id} />
            <div class="lock-row">
              <input class="lock-input" name="email" type="email" required autocomplete="email" placeholder="tu@empresa.com" maxlength="254" aria-label="Email" />
              <button class="lock-btn" type="submit">Desbloquear</button>
            </div>
            <p class="lock-error" role="alert" hidden></p>
            <p class="lock-legal">Solo usamos tu email para enviarte el diagnóstico y, de vez en cuando, ideas para vender más. Puedes darte de baja cuando quieras.</p>
          </form>
        </div>
      )}
    </section>

    <!-- 5. CTA agencia -->
    <section class="res-section cta">
      <div>
        <h2 class="res-h2 cta-title">¿Te lo montamos nosotros?</h2>
        <p class="res-sub">Somos partners certificados de HubSpot, Google y Meta. En una llamada revisamos tu diagnóstico contigo y te contamos cómo lo pondríamos en marcha.</p>
      </div>
      <a class="cta-btn" href={BOOK_A_CALL_URL} target="_blank" rel="noopener">Reservar una llamada</a>
    </section>
  </div>
</SiteLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-capture-form]');
  if (form) {
    const btn = form.querySelector<HTMLButtonElement>('.lock-btn')!;
    const input = form.querySelector<HTMLInputElement>('input[name="email"]')!;
    const errorEl = form.querySelector<HTMLParagraphElement>('.lock-error')!;
    const id = form.querySelector<HTMLInputElement>('input[name="id"]')!.value;

    const showError = (msg: string) => {
      errorEl.textContent = msg;
      errorEl.hidden = false;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.hidden = true;
      const email = input.value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showError('Introduce un email válido.');
        input.focus();
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Preparando tu diagnóstico…';
      try {
        const res = await fetch('/api/capture/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id, email }),
        });
        if (!res.ok) throw new Error(String(res.status));
        window.location.reload();
      } catch {
        btn.disabled = false;
        btn.textContent = 'Desbloquear';
        showError('No hemos podido guardar tu email. Inténtalo de nuevo.');
      }
    });
  }
</script>

<style>
  .res {
    max-width: 960px;
    margin: 0 auto;
    padding: 72px 24px 96px;
    display: flex;
    flex-direction: column;
    gap: 56px;
  }
  .res-eyebrow,
  .res-mono,
  .tile-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.85px;
    text-transform: uppercase;
    color: #a7a7a7;
  }
  .res-h1 {
    margin: 20px 0 0;
    font-size: clamp(34px, 5vw, 56px);
    line-height: 1.1;
    letter-spacing: -2px;
    font-weight: 500;
    text-wrap: balance;
  }
  .res-h2 {
    margin: 32px 0 0;
    font-size: clamp(24px, 3.2vw, 34px);
    line-height: 1.2;
    letter-spacing: -0.8px;
    font-weight: 500;
  }
  .res-lead {
    margin: 20px 0 0;
    font-size: 20px;
    line-height: 1.5;
    letter-spacing: -0.3px;
    color: #e6e6e6;
    max-width: 720px;
  }
  .res-sub {
    margin: 16px 0 0;
    font-size: 15px;
    line-height: 1.55;
    color: #a7a7a7;
    max-width: 640px;
  }
  .res-sub .res-mono { margin-right: 8px; }

  /* Análisis de la web */
  .analysis {
    margin-top: 28px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid #1e1e1e;
    border-radius: 8px;
    overflow: hidden;
  }
  .analysis-item {
    padding: 18px;
    border-right: 1px solid #1e1e1e;
    min-width: 0;
  }
  .analysis-item:nth-child(3n) { border-right: 0; }
  .analysis-item--wide {
    grid-column: 1 / -1;
    border-right: 0;
    border-top: 1px solid #1e1e1e;
  }
  .analysis-value {
    margin-top: 8px;
    font-size: 15px;
    line-height: 1.45;
    color: #e6e6e6;
  }
  .chip.chip--text { font-family: inherit; font-size: 13px; }

  /* Fichas */
  .res-tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }
  .tile {
    background: #141414;
    border: 1px solid #1e1e1e;
    border-radius: 8px;
    padding: 18px;
    min-width: 0;
  }
  .tile--wide { grid-column: 1 / -1; }
  .tile-value {
    margin-top: 8px;
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.5px;
  }
  .tile-value--sm { font-size: 15px; line-height: 1.35; letter-spacing: -0.2px; }
  .tile-value--accent { color: #6798ff; }
  .tile-note { margin-top: 8px; font-size: 14px; color: #a7a7a7; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .chip {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    border: 1px solid #313131;
    border-radius: 4px;
    padding: 3px 8px;
    color: #e6e6e6;
  }

  /* Arquetipo + stack */
  .archetype {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 16px;
  }
  .archetype-emoji {
    font-size: 28px;
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    background: #141414;
    border: 1px solid #1e1e1e;
    border-radius: 8px;
  }
  .archetype-name { font-size: 18px; font-weight: 500; }
  .archetype-tag { font-size: 14px; color: #a7a7a7; margin-top: 2px; }
  .stack {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 12px;
    margin-top: 20px;
  }
  .tool {
    background: #141414;
    border: 1px solid #1e1e1e;
    border-radius: 8px;
    padding: 20px;
    display: flex;
    flex-direction: column;
  }
  .tool-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .tool-num { color: #6798ff; }
  .tool-name { font-size: 17px; font-weight: 500; letter-spacing: -0.3px; }
  .tool-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: #13c28a;
    border: 1px solid rgba(19, 194, 138, 0.4);
    border-radius: 4px;
    padding: 2px 6px;
  }
  .tool-role { margin: 12px 0 0; font-size: 14px; line-height: 1.5; color: #a7a7a7; flex: 1; }
  .tool-cta { margin-top: 16px; font-size: 14px; font-weight: 500; color: #6798ff; }
  .tool-cta:hover { color: #ffffff; }

  /* Bloqueo */
  .why,
  .lock {
    margin-top: 16px;
    background: #141414;
    border: 1px solid #1e1e1e;
    border-radius: 8px;
  }
  .why { padding: 24px; border-left: 3px solid #6798ff; }
  .why-text { margin: 0; font-size: 17px; line-height: 1.65; color: #e6e6e6; }
  .lock { position: relative; overflow: hidden; }
  .lock-preview {
    padding: 24px;
    font-size: 17px;
    line-height: 1.65;
    color: #e6e6e6;
    filter: blur(6px);
    user-select: none;
    pointer-events: none;
  }
  .lock-preview p { margin: 0 0 12px; }
  .lock-card {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 24px;
    background: linear-gradient(180deg, rgba(20, 20, 20, 0.55), rgba(20, 20, 20, 0.95) 45%);
  }
  .lock-title { font-size: 20px; font-weight: 500; letter-spacing: -0.4px; }
  .lock-text { margin: 8px 0 0; font-size: 14px; line-height: 1.5; color: #a7a7a7; max-width: 520px; }
  .lock-row { display: flex; gap: 8px; margin-top: 16px; max-width: 520px; }
  .lock-input {
    flex: 1;
    min-width: 0;
    background: #0a0a0a;
    border: 1px solid #313131;
    border-radius: 8px;
    padding: 12px 14px;
    color: #ffffff;
    font: inherit;
    font-size: 15px;
  }
  .lock-input:focus { outline: none; border-color: #6798ff; }
  .lock-btn {
    background: #ffffff;
    color: #0a0a0a;
    border: 0;
    border-radius: 8px;
    padding: 12px 18px;
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
  }
  .lock-btn:disabled { opacity: 0.7; cursor: progress; }
  .lock-error { margin: 10px 0 0; font-size: 13px; color: #ff7a7a; }
  .lock-legal { margin: 12px 0 0; font-size: 12px; line-height: 1.5; color: #7c7c7c; max-width: 520px; }

  /* CTA */
  .cta {
    background: #141414;
    border: 1px solid #1e1e1e;
    border-radius: 8px;
    padding: 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .cta-title { margin-top: 0; }
  .cta-btn {
    background: #ffffff;
    color: #0a0a0a;
    padding: 12px 20px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
  }
  .cta-btn:hover { color: #0a0a0a; opacity: 0.9; }

  @media (max-width: 720px) {
    .res { padding: 48px 16px 72px; gap: 44px; }
    .res-lead { font-size: 18px; }
    .res-tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .analysis { grid-template-columns: 1fr; }
    .analysis-item { border-right: 0; border-bottom: 1px solid #1e1e1e; }
    .analysis-item--wide { border-top: 0; border-bottom: 0; }
    .cta { flex-direction: column; align-items: flex-start; padding: 24px; }
  }
  @media (max-width: 480px) {
    .lock-row { flex-direction: column; }
    .lock-preview { min-height: 360px; }
  }
</style>
