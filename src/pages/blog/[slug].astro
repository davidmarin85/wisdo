---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import SiteLayout from '@layouts/SiteLayout.astro';
import Cover from '@components/blog/Cover.astro';
import Toc from '@components/blog/Toc.astro';
import ToolRail from '@components/blog/ToolRail.astro';
import ShareChips from '@components/blog/ShareChips.astro';
import DiagnosisCta from '@components/blog/DiagnosisCta.astro';
import PostCard from '@components/blog/PostCard.astro';
import {
  BLOG_CATEGORIES,
  categoryUrl,
  formatDate,
  getPosts,
  readingMinutes,
  relatedPosts,
  type Post,
} from '@lib/blog';
import '@styles/blog.css';

export const prerender = true;

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, related: relatedPosts(post, posts) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  related: Post[];
}

const { post, related } = Astro.props;
const { title, excerpt, category, date, author, tools, cover } = post.data;
const { Content, headings } = await render(post);
const cat = BLOG_CATEGORIES[category];
const minutes = readingMinutes(post);

const site = Astro.site ?? new URL('https://www.wisdo.io');
const url = new URL(Astro.url.pathname, site).href;
const ogImage = cover
  ? new URL((await getImage({ src: cover, width: 1200, height: 630, format: 'jpeg' })).src, site).href
  : undefined;
const toolLabel = category === 'guides' ? 'Tools in this guide' : 'Tools in this comparison';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: excerpt,
  datePublished: date.toISOString(),
  dateModified: date.toISOString(),
  mainEntityOfPage: url,
  ...(ogImage ? { image: [ogImage] } : {}),
  author: { '@type': 'Organization', name: author, url: site.href },
  publisher: {
    '@type': 'Organization',
    name: 'wisdo',
    logo: { '@type': 'ImageObject', url: new URL('/brand/png/wisdo-logo-dark-2x.png', site).href },
  },
};
---

<SiteLayout title={`${title} | wisdo blog`} description={excerpt} ogImage={ogImage} ogType="article" canonical={url} active="blog">
  <Fragment slot="head">
    <meta property="article:published_time" content={date.toISOString()} />
    <link rel="alternate" type="application/rss+xml" title="wisdo blog" href="/blog/rss.xml" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  </Fragment>

  <article>
    <header class="bl-article-head">
      <div class="bl-wrap bl-article-head__inner">
        <div class="bl-mono bl-mono--dim bl-crumb">
          <a href="/blog/">Blog</a><span>/</span><a href={categoryUrl(category)}>{cat.label}</a>
        </div>
        <h1 class="bl-display">{title}</h1>
        <p class="bl-standfirst">{excerpt}</p>
        <div class="bl-mono bl-article-meta">
          <span>{author}</span>
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
          <span>{minutes} min read</span>
        </div>
        <Cover post={post} ratio="21/9" eager sizes="(max-width: 1200px) 100vw, 1152px" class="bl-article-hero" />
      </div>
    </header>

    <div class="bl-wrap bl-layout">
      <Toc headings={headings} />
      <div class="bl-layout__main">
        <div class="bl-prose">
          <Content />
        </div>
        <ToolRail slugs={tools} label={toolLabel} variant="inline" />
      </div>
      <aside class="bl-layout__aside">
        <ToolRail slugs={tools} label={toolLabel} />
        <ShareChips url={url} title={title} />
      </aside>
    </div>
  </article>

  <DiagnosisCta />

  {related.length > 0 && (
    <section class="bl-wrap bl-related" aria-labelledby="related-title">
      <h2 id="related-title">Related</h2>
      <div class="bl-grid">
        {related.map((p) => <PostCard post={p} variant="related" />)}
      </div>
    </section>
  )}
</SiteLayout>
