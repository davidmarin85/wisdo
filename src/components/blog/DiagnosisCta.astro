---
// Banda final de cada artículo: el mismo formulario de diagnóstico de la home.
import DiagnosisForm from '@components/site/DiagnosisForm.astro';
---

<section class="bl-cta bl-grid-bg">
  <div class="bl-wrap bl-cta__inner">
    <div>
      <div class="bl-mono">Next step</div>
      <h2 class="bl-cta__title">Want us to set this up for you?</h2>
      <p class="bl-cta__sub">Run a free diagnosis of your site and stack.</p>
    </div>
    <DiagnosisForm id="blog-diagnosis" label="Free diagnosis" note="No signup. Takes about a minute." />
  </div>
</section>
