---
import SEO from '@components/SEO.astro';
import SiteNav from '@components/site/SiteNav.astro';
import SiteFooter from '@components/site/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  canonical?: string | undefined;
  ogImage?: string;
  /** Which nav pill renders as active */
  active?: 'solutions' | 'ai-automation' | 'market' | null;
}

const {
  title,
  description,
  noindex = false,
  canonical,
  ogImage,
  active = null,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400&family=Space+Grotesk:wght@700&display=swap"
      rel="stylesheet"
    />
    <SEO
      title={title}
      description={description}
      noindex={noindex}
      canonical={canonical}
      ogImage={ogImage}
    />
  </head>
  <body>
    <div style="background:#0a0a0a; color:#ffffff; font-family:'Inter',system-ui,sans-serif; min-height:100vh;">
      <SiteNav active={active} />
      <main>
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    background: #0a0a0a;
    font-family: 'Inter', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  * { box-sizing: border-box; }
  a { color: #ffffff; text-decoration: none; }
  a:hover { color: #6798ff; }

</style>
