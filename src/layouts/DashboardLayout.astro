---
// Layout privado del dashboard: sidebar fija a la izquierda, contenido a la
// derecha. Mismo lenguaje visual que /diagnosis/ (fondo #0a0a0a, tarjetas
// #141414, acento #6798ff, Inter + JetBrains Mono). Siempre noindex.
import SEO from '@components/SEO.astro';
import { BOOK_A_CALL_URL } from '@data/site';
import type { User } from '@supabase/supabase-js';

type Section = 'home' | 'report' | 'analyze';

interface NavItem {
  label: string;
  href: string;
  icon: 'home' | 'report' | 'scan' | 'market' | 'call';
  /** Sección del dashboard que marca este enlace como activo. */
  section?: Section;
  /** Sale del dashboard (se abre en otra pestaña). */
  external?: boolean;
}

interface Props {
  title: string;
  user: User;
  active?: Section;
}

const { title, user, active = 'home' } = Astro.props;

// Home, informe y análisis viven dentro del dashboard; Market y la llamada
// son destinos de fuera y se abren en otra pestaña.
const nav: NavItem[] = [
  { label: 'Home', href: '/dashboard/', icon: 'home', section: 'home' },
  { label: 'Full report', href: '/dashboard/report/', icon: 'report', section: 'report' },
  { label: 'New analysis', href: '/dashboard/analyze/', icon: 'scan', section: 'analyze' },
  { label: 'Market', href: '/market/', icon: 'market', external: true },
  { label: 'Book a call', href: BOOK_A_CALL_URL, icon: 'call', external: true },
];

const ICONS: Record<NavItem['icon'], string> = {
  home: 'M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z',
  report: 'M6 3h9l4 4v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zm8 0v5h5M9 13h6M9 17h6',
  scan: 'M4 8V5a1 1 0 0 1 1-1h3M16 4h3a1 1 0 0 1 1 1v3M20 16v3a1 1 0 0 1-1 1h-3M8 20H5a1 1 0 0 1-1-1v-3M4 12h16',
  market: 'M4 10l1.5-5h13L20 10M4 10h16M4 10v9a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-9M10 20v-6h4v6',
  call: 'M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1z',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400&family=Space+Grotesk:wght@700&display=swap"
      rel="stylesheet"
    />
    <SEO title={`${title} — wisdo`} description="Your wisdo dashboard" noindex={true} />
  </head>
  <body>
    <div class="db">
      <aside class="db-side">
        <a href="/" class="db-logo" aria-label="wisdo — home">
          <span class="db-logo-dot" aria-hidden="true"></span>
          <span class="db-logo-text">wisdo</span>
        </a>

        <nav class="db-nav" aria-label="Dashboard">
          {nav.map((item) => {
            const current = item.section === active;
            return (
              <a
                class="db-nav-item"
                href={item.href}
                aria-current={current ? 'page' : undefined}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener' : undefined}
              >
                <svg class="db-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={ICONS[item.icon]} />
                </svg>
                <span>{item.label}</span>
              </a>
            );
          })}
        </nav>

        <div class="db-side-foot">
          <span class="db-user" title={user.email}>{user.email}</span>
          <form action="/api/auth/logout/" method="post">
            <button class="db-signout" type="submit">Sign out</button>
          </form>
        </div>
      </aside>

      <main class="db-main">
        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --db-bg: #0a0a0a;
    --db-surface: #141414;
    --db-surface-2: #1a1a1a;
    --db-border: #1e1e1e;
    --db-border-strong: #313131;
    --db-text: #ffffff;
    --db-text-2: #e6e6e6;
    --db-muted: #a7a7a7;
    --db-faint: #7c7c7c;
    --db-accent: #6798ff;
    --db-green: #13c28a;
    --db-red: #ff7a7a;
    --db-mono: 'JetBrains Mono', monospace;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--db-bg);
    color: var(--db-text);
    font-family: 'Inter', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-decoration: none; }
</style>

<style>
  .db {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    min-height: 100vh;
  }
  .db-side {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 24px 16px;
    border-right: 1px solid var(--db-border);
  }
  .db-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 12px;
  }
  .db-logo-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--db-green);
    box-shadow: 0 0 12px var(--db-green);
  }
  .db-logo-text { font: 700 21px 'Space Grotesk', sans-serif; letter-spacing: -0.42px; }
  .db-nav { display: flex; flex-direction: column; gap: 2px; }
  .db-nav-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 8px;
    font-size: 15px;
    color: var(--db-text-2);
  }
  .db-nav-item:hover { background: var(--db-surface); }
  .db-nav-item[aria-current='page'] { background: var(--db-surface); color: var(--db-text); font-weight: 500; }
  .db-nav-icon { width: 18px; height: 18px; flex: none; color: var(--db-muted); }
  .db-nav-item[aria-current='page'] .db-nav-icon { color: var(--db-accent); }
  .db-side-foot {
    margin-top: auto;
    padding: 16px 12px 0;
    border-top: 1px solid var(--db-border);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .db-user {
    font-size: 13px;
    color: var(--db-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .db-signout {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    font-size: 13px;
    color: var(--db-faint);
    cursor: pointer;
  }
  .db-signout:hover { color: var(--db-text); }
  .db-main {
    padding: 40px 48px 80px;
    min-width: 0;
  }

  @media (max-width: 900px) {
    .db { grid-template-columns: 1fr; }
    .db-side {
      position: static;
      height: auto;
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px 16px;
      padding: 14px 16px;
      border-right: 0;
      border-bottom: 1px solid var(--db-border);
    }
    .db-nav { flex-direction: row; flex-wrap: wrap; gap: 2px; }
    .db-nav-item { padding: 8px 10px; font-size: 14px; }
    .db-nav-item span { display: none; }
    .db-nav-item[aria-current='page'] span { display: inline; }
    .db-side-foot {
      margin-top: 0;
      margin-left: auto;
      padding: 0;
      border: 0;
      flex-direction: row;
      align-items: center;
      gap: 12px;
    }
    .db-user { display: none; }
    .db-main { padding: 28px 16px 64px; }
  }
</style>
